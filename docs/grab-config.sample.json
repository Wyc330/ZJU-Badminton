{
  "_comment": "完整字段见 App 内「导出默认配置」；这里是最常改的部分，键名与代码一致",
  "targetPackage": "net.crigh.mysport",

  "releaseHour": 9,
  "releaseMinute": 0,
  "releaseSecond": 0,
  "waitForRelease": true,
  "slotRetryMs": 20000,

  "dateCfg": {
    "useNextReleaseDate": true,
    "releaseDaysAhead": 2,
    "fridayAfternoonOnly": false,
    "includeToday": true,
    "maxDaysAhead": 0,
    "datePatterns": [
      "(\\d{4})\\s*[-/\\.年]\\s*(\\d{1,2})\\s*[-/\\.月]\\s*(\\d{1,2})",
      "(\\d{1,2})\\s*[-/\\.月]\\s*(\\d{1,2})\\s*日?"
    ]
  },

  "preferredSlotStart": "",
  "turboMode": true,

  "directVenueName": "风雨操场",
  "directVenueSiteId": 0,
  "directMaxWaitMs": 120000,
  "directPollMinMs": 250,
  "directPollJitterMs": 400,
  "directMaxAttempts": 240,

  "companionName": "",
  "inviteCodeWaitMs": 120000,

  "entryService": [
    { "id": "tv_home_model_title", "contains": "场馆服务" },
    { "contains": "场馆服务" }
  ],
  "entryBooking": [{ "contains": "场馆预约" }],
  "bookingPageReady": [
    { "contains": "预约日期" },
    { "contains": "我要预约" }
  ],
  "campusTarget": "紫金港校区",
  "venueFengYu": [{ "contains": "风雨操场" }],
  "venueBadminton": [{ "contains": "羽毛球场" }, { "contains": "羽毛球" }],

  "slotRowLabel": {
    "regex": "\\d{1,2}\\s*[:：]\\s*\\d{2}\\s*[-~—－–]\\s*\\d{1,2}\\s*[:：]\\s*\\d{2}",
    "order": "TOP_LEFT"
  },
  "slotColumnHeader": { "regex": "^\\s*\\d+\\s*号\\s*$", "order": "LEFT_TOP" },
  "slotGridCfg": {
    "availableColors": ["#67C23A", "#52C41A", "#4CAF50", "#6BCB77", "#8ECF75"],
    "bookedColors": ["#FE4B37", "#EB5E54", "#F5333F", "#FF4D3A"],
    "unpaidColors": ["#FFB800", "#FAAD14", "#FEC43F", "#FFC107"],
    "selectedColors": ["#40A9FF", "#75BEF3", "#1890FF"],
    "closedColors": ["#D9D9D9", "#BFBFBF", "#EEEEEE", "#E0E0E0"]
  }
}
