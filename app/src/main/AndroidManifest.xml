<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== 权限 ========== -->
    <!-- 精确定时：Android 12+ 需要用户在系统设置里授予「闹钟和提醒」 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 14 起全屏 Intent 需要声明（用于到点自动弹起页面） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 允许从后台拉起目标 App：Android 10+ 无「显示在其他应用上层」会被系统拦截 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 包可见性：只查询目标 App，不申请 QUERY_ALL_PACKAGES -->
    <queries>
        <package android:name="net.crigh.mysport" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CourtGrab"
        tools:targetApi="34">

        <!-- ========== 主界面 ========== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 内置场馆系统登录页：仅用于获取直连下单所需的登录态 -->
        <activity
            android:name=".direct.VenueLoginActivity"
            android:exported="false"
            android:label="登录场馆系统"
            android:windowSoftInputMode="adjustResize" />

        <!-- ========== 到点后要求输入「本次邀请码」的全屏页 ========== -->
        <activity
            android:name=".ui.CodeRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=".coderequest"
            android:theme="@style/Theme.CourtGrab.Dialog"
            android:turnScreenOn="true" />

        <!-- ========== 无障碍服务 ========== -->
        <service
            android:name=".a11y.VenueAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ========== 抢场地期间保活的前台服务 ========== -->
        <service
            android:name=".service.GrabForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="automation during a user-scheduled alarm; keeps the accessibility-driven booking flow alive for a few seconds" />
        </service>

        <!-- ========== 定时闹钟 ========== -->
        <receiver
            android:name=".alarm.BookingAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zju.courtgrab.action.DAILY_FIRE" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 应用更新后重新排闹钟 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ========== 分享抓取结果 ========== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
